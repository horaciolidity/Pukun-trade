# ==============================================================================
# VARIABLES DE ENTORNO - PUKUN TRADE (EJEMPLO)
# Copia este archivo a .env y completa con tus valores reales
# ==============================================================================

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Gemini AI (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key"

# App & Security
APP_URL="http://localhost:3000"
JWT_SECRET="change-this-to-a-secure-random-string"

# OxaPay Crypto Gateway (Server-side only — never expose with VITE_)
OXAPAY_MERCHANT_API_KEY="your-oxapay-merchant-api-key"
OXAPAY_PAYOUT_API_KEY="your-oxapay-payout-api-key"
